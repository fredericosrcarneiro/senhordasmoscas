<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resultados da Turma - Senhor das Moscas</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap');

  :root{
    --ash:#f4f2ec;
    --ash-2:#ffffff;
    --bone:#161512;
    --bone-dim:#655f52;
    --line:#dcd7cb;
    --moral:#3f5940;
    --racional:#3a5975;
    --social:#b85f26;
    --emocional:#8a3838;
    --coletivo:#8a6f3d;
    --ralph:#3a5975;
    --jack:#8a3838;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; padding:28px 16px 60px;
    background:var(--ash);
    color:var(--bone);
    font-family:'Work Sans',sans-serif;
  }
  .wrap{max-width:1080px; margin:0 auto;}
  h1{
    font-family:'Fraunces',serif; font-weight:700;
    font-size:clamp(24px,4vw,32px); margin:0 0 6px;
  }
  .sub{color:var(--bone-dim); font-size:14.5px; max-width:70ch; line-height:1.5;}
  .caveat{
    background:var(--ash-2); border:1px solid var(--line); border-left:4px solid var(--social);
    border-radius:4px; padding:14px 16px; margin:22px 0; font-size:13.5px; line-height:1.55;
  }
  .caveat strong{color:var(--bone);}
  h2{
    font-family:'Fraunces',serif; font-weight:600; font-size:19px;
    margin:36px 0 14px; padding-bottom:8px; border-bottom:1px solid var(--line);
  }
  .stat-row{display:flex; flex-wrap:wrap; gap:14px; margin-bottom:8px;}
  .stat-card{
    background:var(--ash-2); border:1px solid var(--line); border-radius:6px;
    padding:16px 20px; flex:1 1 150px; min-width:130px; text-align:center;
  }
  .stat-card .num{font-family:'Fraunces',serif; font-size:28px; font-weight:700;}
  .stat-card .lbl{font-size:12px; color:var(--bone-dim); margin-top:4px;}

  .chart-card{
    background:var(--ash-2); border:1px solid var(--line); border-radius:6px; padding:20px;
  }
  .legend-row{display:flex; gap:18px; flex-wrap:wrap; margin-top:14px; font-size:12.5px; color:var(--bone-dim);}
  .legend-row span{display:inline-flex; align-items:center; gap:6px;}
  .legend-row .sw{width:11px; height:11px; border-radius:2px; display:inline-block;}

  .char-grid{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:18px;
  }
  .char-card{
    background:var(--ash-2); border:1px solid var(--line); border-radius:6px;
    padding:14px; text-align:center;
  }
  .char-card h3{
    font-family:'Fraunces',serif; font-size:16px; margin:6px 0 2px; font-weight:700;
  }
  .char-card .note{font-size:11.5px; color:var(--bone-dim); margin-top:6px; line-height:1.4;}

  table{width:100%; border-collapse:collapse; font-size:13.5px; background:var(--ash-2); border:1px solid var(--line); border-radius:6px; overflow:hidden;}
  th,td{padding:9px 12px; text-align:left; border-bottom:1px solid var(--line);}
  th{background:var(--ash); font-weight:600; font-size:12.5px; color:var(--bone-dim); text-transform:uppercase; letter-spacing:.02em;}
  tr:last-child td{border-bottom:none;}
  .tag{
    display:inline-block; padding:2px 8px; border-radius:20px; font-size:11.5px; font-weight:600;
  }
  .tag-alto{background:#f3e3e3; color:#8a3838;}
  .tag-medio{background:#efe9d8; color:#8a6f3d;}
  .tag-baixo{background:#e9edf0; color:#655f52;}

  .letter-card{
    background:var(--ash); border:1px solid var(--line); border-radius:6px;
    padding:14px 16px; margin-bottom:12px;
  }
  .letter-card .who{font-weight:600; font-size:13.5px; margin-bottom:2px;}
  .letter-card .gender-tag{font-size:11.5px; color:var(--bone-dim); font-weight:400;}
  .letter-card .text{font-size:13.5px; line-height:1.55; margin-top:6px; white-space:pre-wrap;}
  .letter-card .text.empty{color:var(--bone-dim); font-style:italic;}

  footer{margin-top:40px; font-size:12px; color:var(--bone-dim); text-align:center;}
</style>
</head>
<body>
<div class="wrap">
  <h1>Resultados da Turma — Roda de Construção de Personagem</h1>
  <div class="sub">O Senhor das Moscas · 28 respostas analisadas</div>

  <div class="caveat">
    <strong>Nota sobre os dados quantitativos:</strong> os níveis dos eixos (Baixo / Médio / Alto) vêm de uma leitura visual das rodas exportadas em PDF, não de uma medição exata anel a anel — pequenas diferenças de nível (ex.: 2 vs. 3) não são garantidas. As contagens de grupo e gênero, por outro lado, vêm direto do texto preenchido pelos alunos e são exatas.
  </div>

  <h2>Visão geral</h2>
  <div class="stat-row">
    <div class="stat-card"><div class="num">28</div><div class="lbl">Alunos</div></div>
    <div class="stat-card"><div class="num">21</div><div class="lbl">Grupo de Ralph</div></div>
    <div class="stat-card"><div class="num">7</div><div class="lbl">Tribo de Jack</div></div>
    <div class="stat-card"><div class="num">14 / 11 / 3</div><div class="lbl">Fem. / Masc. / N.I.</div></div>
  </div>

  <h2>Grupo escolhido, por gênero</h2>
  <div class="chart-card">
    <svg id="groupChart" viewBox="0 0 700 260" style="width:100%; height:auto; display:block;"></svg>
    <div class="legend-row">
      <span><span class="sw" style="background:var(--ralph)"></span>Grupo de Ralph</span>
      <span><span class="sw" style="background:var(--jack)"></span>Tribo de Jack</span>
    </div>
  </div>

  <h2>Personagem escolhido para a carta, por gênero</h2>
  <div class="chart-card">
    <svg id="letterChart" viewBox="0 0 700 320" style="width:100%; height:auto; display:block;"></svg>
    <div class="legend-row" id="letterLegend"></div>
    <div class="sub" style="margin-top:10px;">Dado exato — extraído diretamente do campo "Carta para" preenchido por cada aluno (não é leitura visual).</div>
  </div>

  <h2>Nível típico por eixo, em cada personagem</h2>
  <div class="char-grid" id="charGrid"></div>

  <h2>Resumo por eixo (tabela)</h2>
  <table id="axisTable">
    <thead>
      <tr><th>Personagem</th><th>Moral</th><th>Cognitivo</th><th>Liderança</th><th>Emocional</th><th>Coletivo</th><th>Leitura</th></tr>
    </thead>
    <tbody></tbody>
  </table>

  <h2>Análise de conteúdo: enquadramentos (framings) das cartas</h2>
  <div class="caveat">
    <strong>Nota metodológica:</strong> esta categorização é uma leitura interpretativa única, feita por mim a partir do conteúdo de cada carta — não é uma classificação objetiva nem exaustiva. Uma carta pode conter elementos de mais de um enquadramento; aqui cada uma foi enquadrada pelo tom dominante.
  </div>
  <div class="char-picker" id="framingGenderFilter" style="margin-bottom:14px;"></div>
  <div class="chart-card">
    <svg id="framingChart" viewBox="0 0 700 340" style="width:100%; height:auto; display:block;"></svg>
  </div>
  <table style="margin-top:16px;">
    <thead><tr><th>Framing</th><th>Descrição</th><th>Nº</th><th>Exemplo</th></tr></thead>
    <tbody id="framingTable"></tbody>
  </table>

  <h2>Ler as cartas por personagem</h2>
  <div class="chart-card">
    <select id="letterFilter" style="width:100%; max-width:280px; padding:9px 12px; border-radius:4px; border:1px solid var(--line); background:var(--ash); color:var(--bone); font-family:'Work Sans',sans-serif; font-size:14px; margin-bottom:16px;"></select>
    <div id="letterList"></div>
  </div>

  <footer>Gerado a partir de 28 fichas preenchidas pelos alunos — leitura visual das rodas, não medição exata.</footer>
</div>

<script>
const AXES = [
  {id:'moral', label:'Moral', hex:'#3f5940'},
  {id:'racional', label:'Cognitivo', hex:'#3a5975'},
  {id:'social', label:'Liderança', hex:'#b85f26'},
  {id:'emocional', label:'Emocional', hex:'#8a3838'},
  {id:'coletivo', label:'Coletivo', hex:'#8a6f3d'},
];
const BAND = {baixo:1, medio:3, alto:5};
const BANDLABEL = {baixo:'Baixo', medio:'Médio', alto:'Alto'};

const CHAR_DATA = {
  'Ralph':     {moral:'medio', racional:'alto',  social:'medio', emocional:'alto',  coletivo:'medio'},
  'Jack':      {moral:'alto',  racional:'alto',  social:'alto',  emocional:'alto',  coletivo:'alto'},
  'Porquinho': {moral:'baixo', racional:'baixo', social:'baixo', emocional:'alto',  coletivo:'baixo'},
  'Simon':     {moral:'baixo', racional:'baixo', social:'baixo', emocional:'alto',  coletivo:'baixo'},
  'Roger':     {moral:'alto',  racional:'alto',  social:'alto',  emocional:'alto',  coletivo:'alto'},
};

// ---- bar chart: group choice by gender ----
(function(){
  const svg = document.getElementById('groupChart');
  const data = [
    {label:'Feminino', ralph:11, jack:3},
    {label:'Masculino', ralph:7, jack:4},
    {label:'Não informado', ralph:3, jack:0},
  ];
  const W=700,H=260, padL=60, padB=40, padT=20, chartW=W-padL-40, chartH=H-padB-padT;
  const maxVal = 12;
  const groupW = chartW/data.length;
  let svgContent = '';
  // axis line
  svgContent += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+chartH}" stroke="#dcd7cb"/>`;
  svgContent += `<line x1="${padL}" y1="${padT+chartH}" x2="${padL+chartW}" y2="${padT+chartH}" stroke="#dcd7cb"/>`;
  [0,3,6,9,12].forEach(v=>{
    const y = padT+chartH-(v/maxVal)*chartH;
    svgContent += `<line x1="${padL}" y1="${y}" x2="${padL+chartW}" y2="${y}" stroke="#eee" stroke-dasharray="3,3"/>`;
    svgContent += `<text x="${padL-10}" y="${y+4}" font-size="11" fill="#655f52" text-anchor="end" font-family="Work Sans, sans-serif">${v}</text>`;
  });
  data.forEach((d,i)=>{
    const gx = padL + i*groupW;
    const barW = 46;
    const gapMid = 8;
    const x1 = gx + groupW/2 - barW - gapMid/2;
    const x2 = gx + groupW/2 + gapMid/2;
    const h1 = (d.ralph/maxVal)*chartH;
    const h2 = (d.jack/maxVal)*chartH;
    svgContent += `<rect x="${x1}" y="${padT+chartH-h1}" width="${barW}" height="${h1}" fill="#3a5975" rx="2"/>`;
    svgContent += `<text x="${x1+barW/2}" y="${padT+chartH-h1-6}" font-size="12" fill="#161512" text-anchor="middle" font-weight="600" font-family="Work Sans, sans-serif">${d.ralph}</text>`;
    svgContent += `<rect x="${x2}" y="${padT+chartH-h2}" width="${barW}" height="${h2}" fill="#8a3838" rx="2"/>`;
    svgContent += `<text x="${x2+barW/2}" y="${padT+chartH-h2-6}" font-size="12" fill="#161512" text-anchor="middle" font-weight="600" font-family="Work Sans, sans-serif">${d.jack}</text>`;
    svgContent += `<text x="${gx+groupW/2}" y="${padT+chartH+22}" font-size="12.5" fill="#161512" text-anchor="middle" font-family="Work Sans, sans-serif">${d.label}</text>`;
  });
  svg.innerHTML = svgContent;
})();

// ---- grouped bar: characters on x-axis, gender as the cut ----
(function(){
  const svg = document.getElementById('letterChart');
  const GENDER_COLORS = {
    'Feminino':'#9c4f6a', 'Masculino':'#3a5975', 'Não informado':'#9c9483'
  };
  const genders = ['Feminino','Masculino','Não informado'];
  // personagem -> genero -> contagem (extraído do campo "Carta para")
  const data = [
    {name:'Ralph',     Feminino:3, Masculino:5, 'Não informado':1},
    {name:'Jack',      Feminino:7, Masculino:1, 'Não informado':0},
    {name:'Porquinho', Feminino:2, Masculino:4, 'Não informado':0},
    {name:'Simon',     Feminino:1, Masculino:1, 'Não informado':1},
    {name:'Roger',     Feminino:1, Masculino:0, 'Não informado':0},
  ];
  const W=700,H=320, padL=60, padR=20, padT=20, padB=40;
  const chartW=W-padL-padR, chartH=H-padT-padB;
  const maxVal = 8;
  const groupW = chartW/data.length;
  const barW = 20, barGap = 4;
  let s = '';
  s += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+chartH}" stroke="#dcd7cb"/>`;
  s += `<line x1="${padL}" y1="${padT+chartH}" x2="${padL+chartW}" y2="${padT+chartH}" stroke="#dcd7cb"/>`;
  [0,2,4,6,8].forEach(v=>{
    const y = padT+chartH-(v/maxVal)*chartH;
    s += `<line x1="${padL}" y1="${y}" x2="${padL+chartW}" y2="${y}" stroke="#eee" stroke-dasharray="3,3"/>`;
    s += `<text x="${padL-10}" y="${y+4}" font-size="11" fill="#655f52" text-anchor="end" font-family="Work Sans, sans-serif">${v}</text>`;
  });
  data.forEach((d,i)=>{
    const gx = padL + i*groupW + groupW/2 - (genders.length*barW + (genders.length-1)*barGap)/2;
    genders.forEach((g,j)=>{
      const v = d[g] || 0;
      const h = (v/maxVal)*chartH;
      const x = gx + j*(barW+barGap);
      s += `<rect x="${x}" y="${padT+chartH-h}" width="${barW}" height="${h}" fill="${GENDER_COLORS[g]}" rx="2"/>`;
      if(v>0) s += `<text x="${x+barW/2}" y="${padT+chartH-h-6}" font-size="11" fill="#161512" text-anchor="middle" font-weight="600" font-family="Work Sans, sans-serif">${v}</text>`;
    });
    s += `<text x="${padL+i*groupW+groupW/2}" y="${padT+chartH+22}" font-size="12.5" fill="#161512" text-anchor="middle" font-family="Work Sans, sans-serif">${d.name}</text>`;
  });
  svg.innerHTML = s;

  const legend = document.getElementById('letterLegend');
  genders.forEach(g=>{
    const span = document.createElement('span');
    span.innerHTML = `<span class="sw" style="background:${GENDER_COLORS[g]}"></span>${g}`;
    legend.appendChild(span);
  });
})();

// ---- mini aggregate wheels per character ----
function polar(cx,cy,r,angDeg){
  const a=(angDeg-90)*Math.PI/180;
  return {x:cx+r*Math.cos(a), y:cy+r*Math.sin(a)};
}
function donutPath(cx,cy,r1,r2,a1,a2){
  const p1=polar(cx,cy,r2,a1), p2=polar(cx,cy,r2,a2);
  const p3=polar(cx,cy,r1,a2), p4=polar(cx,cy,r1,a1);
  const large=(a2-a1)>180?1:0;
  return `M ${p1.x} ${p1.y} A ${r2} ${r2} 0 ${large} 1 ${p2.x} ${p2.y} L ${p3.x} ${p3.y} A ${r1} ${r1} 0 ${large} 0 ${p4.x} ${p4.y} Z`;
}
function buildMiniWheelSvg(name, bands){
  const cx=110, cy=110, rInner=20, rOuter=95, levels=5, gap=1.5, wedgeGap=2;
  const wedgeAngle = 360/AXES.length;
  const ringW = (rOuter-rInner)/levels;
  let s = `<svg viewBox="0 0 220 220" width="100%" height="auto">`;
  AXES.forEach((axis,i)=>{
    const a1=i*wedgeAngle+wedgeGap/2, a2=(i+1)*wedgeAngle-wedgeGap/2;
    const val = BAND[bands[axis.id]] || 0;
    for(let lvl=1; lvl<=levels; lvl++){
      const r1=rInner+(lvl-1)*ringW+gap/2, r2=rInner+lvl*ringW-gap/2;
      const fill = lvl<=val ? axis.hex : '#ffffff';
      const op = lvl<=val ? (0.5+(lvl/levels)*0.5) : 1;
      s += `<path d="${donutPath(cx,cy,r1,r2,a1,a2)}" fill="${fill}" fill-opacity="${op}" stroke="#dcd7cb" stroke-width="1"/>`;
    }
  });
  s += `<circle cx="${cx}" cy="${cy}" r="${rInner-3}" fill="#ffffff"/>`;
  s += `</svg>`;
  return s;
}

const grid = document.getElementById('charGrid');
Object.keys(CHAR_DATA).forEach(name=>{
  const bands = CHAR_DATA[name];
  const div = document.createElement('div');
  div.className = 'char-card';
  div.innerHTML = buildMiniWheelSvg(name, bands) + `<h3>${name}</h3>`;
  grid.appendChild(div);
});

const tbody = document.querySelector('#axisTable tbody');
Object.keys(CHAR_DATA).forEach(name=>{
  const bands = CHAR_DATA[name];
  const tr = document.createElement('tr');
  let cells = `<td><strong>${name}</strong></td>`;
  AXES.forEach(axis=>{
    const b = bands[axis.id];
    cells += `<td><span class="tag tag-${b}">${BANDLABEL[b]}</span></td>`;
  });
  const allSame = new Set(Object.values(bands)).size === 1;
  cells += `<td style="font-size:12px; color:var(--bone-dim);">${allSame ? 'Tratado como extremo em todos os eixos' : (bands.emocional==='alto' && bands.moral==='baixo' ? 'Só o Emocional se destaca' : '—')}</td>`;
  tr.innerHTML = cells;
  tbody.appendChild(tr);
});

