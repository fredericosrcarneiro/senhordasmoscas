function renderFraming(genderFilter){
  const rows = genderFilter==='Todos' ? FRAMING_ROWS : FRAMING_ROWS.filter(r=>r.gender===genderFilter);
  const counts = {};
  FRAMINGS.forEach(f=>counts[f.id]=0);
  rows.forEach(r=>counts[r.framing]=(counts[r.framing]||0)+1);
  const present = FRAMINGS.filter(f=>counts[f.id]>0);
  const sorted = present.length ? [...present].sort((a,b)=>counts[b.id]-counts[a.id]) : [];

  const svg = document.getElementById('framingChart');
  const W=700, padL=210, padR=50, padT=10, padB=10;
  const barH = 26;
  const n = sorted.length || 1;
  const chartH = Math.max(n*36 - 10, 40);
  svg.setAttribute('viewBox', `0 0 ${W} ${chartH+padT+padB}`);
  const chartW=W-padL-padR;
  const gapY = n>1 ? (chartH - barH*n)/(n-1) : 0;
  const maxVal = Math.max(...sorted.map(f=>counts[f.id]), 1);
  let s = '';
  if(sorted.length===0){
    s = `<text x="${W/2}" y="${chartH/2}" font-size="13" fill="#655f52" text-anchor="middle" font-family="Work Sans, sans-serif">Nenhuma carta desse gênero foi classificada.</text>`;
  }
  sorted.forEach((f,i)=>{
    const y = padT + i*(barH+gapY);
    const v = counts[f.id];
    const w = (v/maxVal)*chartW;
    s += `<rect x="${padL}" y="${y}" width="${w}" height="${barH}" fill="${f.color}" rx="3"/>`;
    s += `<text x="${padL-10}" y="${y+barH/2+4}" font-size="12.5" fill="#161512" text-anchor="end" font-family="Work Sans, sans-serif">${f.label}</text>`;
    s += `<text x="${padL+w+8}" y="${y+barH/2+4}" font-size="12" fill="#655f52" text-anchor="start" font-family="Work Sans, sans-serif">${v}</text>`;
  });
  svg.innerHTML = s;

  const tbody = document.getElementById('framingTable');
  tbody.innerHTML = '';
  (sorted.length ? sorted : FRAMINGS).forEach(f=>{
    if(sorted.length && counts[f.id]===0) return;
    const candidates = rows.filter(r=>r.framing===f.id);
    const exAluno = candidates.length ? candidates[0].aluno : null;
    const exText = exAluno ? ALUNO_QUOTE[exAluno] : '—';
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><strong>${f.label}</strong></td><td style="font-size:12.5px; color:var(--bone-dim);">${f.desc}</td><td>${counts[f.id]}</td><td style="font-size:12.5px;">${exAluno ? exAluno+': <em>'+exText+'</em>' : '—'}</td>`;
    tbody.appendChild(tr);
  });
}

const GENDER_FILTER_OPTIONS = ['Todos','Feminino','Masculino','Não informado'];
